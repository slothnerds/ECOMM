# Profile "docker": PostgreSQL from db/docker-compose.yml (start it with: docker compose -f db/docker-compose.yml up -d).
# Activate with: APP_PROFILE=docker
# LOCAL DEV values only, committed on purpose for this POC.
APP_PROFILE=docker
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecomm_db
DB_USER=postgres
DB_PASSWORD=password
