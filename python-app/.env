# Settings for the FastAPI app shared by every profile, read by ecommerce/core/config.py.
# Database settings are per profile: .env.local (default) or .env.docker, chosen by APP_PROFILE.
# LOCAL DEV values only, committed on purpose for this POC.
# A real environment variable with the same name overrides each line.

APP_ENV=dev
# Secret used to sign JWTs (Stage 6). Must be at least 32 characters.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
# How long checkout holds stock before it is released (ISO-8601 duration)
HOLD_DURATION=PT15M
